# --- Database ---
# Dev: in-memory mongomock with JSON snapshot persistence (backend/.devdata/snapshot.json)
MONGODB_URI=mongomock://demo
# Prod: Atlas connection string
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rowdys_den

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_DAYS=14
# Web OAuth client ID (React frontend). Required for Google sign-in.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Optional — comma-separated EXTRA client IDs, e.g. Flutter app Android/iOS OAuth
# clients from the SAME Google Cloud project. Web client stays as-is above.
GOOGLE_CLIENT_IDS=
AUTH_DEV_MODE=true
AUTH_DISABLED=false
MASTER_ADMIN_EMAILS=master@rowdys.dev

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173

# --- Mail (optional — without SMTP_HOST mails are recorded in `mailouts` only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rowdy's Den <no-reply@example.com>
APP_PUBLIC_URL=https://rowdysden.example.com
